# Required: create a Gemini API key at Google AI Studio.
# Also used by the studio console's Google Veo motion path (tab 2/3).
# You CAN instead type the key into tab 2, but a key entered there lives
# only in the running process -- if the server restarts while a paid Veo
# generation is still in flight, it cannot be resumed and that spend is
# lost. Put it here if you care about that.
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: override config file paths
LYRIA_AUTO_SETTINGS=config/settings.yaml
LYRIA_AUTO_CHANNELS=config/channels.yaml

# Optional: log level
LOG_LEVEL=INFO
