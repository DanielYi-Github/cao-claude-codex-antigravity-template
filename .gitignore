# CAO project runtime (database, logs, FIFOs, installed profiles, journal)
# Keep .cao/profiles/, .cao/skills/, and .cao/workflows/ tracked.
.cao/runtime/
.cao/db/
.cao/logs/
.cao/fifos/
.cao/locks/
.cao/agent-store/
.cao/agent-context/
.cao/graph-exports/
.cao/settings.json
.cao/.env
.cao/tmp/

# Runtime artifacts may contain model output; keep the directory but ignore files.
artifacts/*
!artifacts/README.md
!artifacts/spec.md
!artifacts/architecture.md
!artifacts/review.md
!artifacts/ui-notes.md
!artifacts/schema.md
!artifacts/test-report.md

# Secrets and local environment files
.env
.env.*
!.env.example
*.pem
*.key

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/

# Local editor and OS files
.DS_Store
.idea/
.vscode/

# Optional sibling worktrees created for workers
.worktrees/

# --- lyria_auto / chowchow studio runtime ---
secrets/*
!secrets/.gitkeep
workspace/*
!workspace/.gitkeep
logs/*
!logs/.gitkeep
assets/backgrounds/*
!assets/backgrounds/.gitkeep

# Private chow chow reference photos, videos, and intermediate drafts.
# Keep the approved, production-ready references versionable by default.
comfyui-assets/character-reference/chowchow/source/*
!comfyui-assets/character-reference/chowchow/source/.gitkeep
comfyui-assets/character-reference/chowchow/working/*
!comfyui-assets/character-reference/chowchow/working/.gitkeep
comfyui-assets/.staged/
console/node_modules/
console/.git/
